/-- Outer summand of `rowSlotBound 127 239 609 280 1148 512 1 271081`. -/
private def mcaRowTerm (t : Nat) : Nat :=
  512 * gradedRankBound 127 239 609 280 t * (271081 + 1 - 1 * t)

