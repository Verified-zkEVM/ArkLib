module

public import ArkLib.Data.CodingTheory.HiddenDerivative.Interpolation.FirstOrder.CurveHeightCounting

/-!
# Kernel-reducible slot counts

The first-order certificate theorems need the slot inequality
`firstOrderCurveShiftedRowSlotBound … < firstOrderCurveShiftedHeightSlotCount …` at concrete
parameters. Both sides are `Finset.range` sums, which the kernel does not reduce well. This file
restates them over a structurally recursive `sumRange` and proves that the restatements agree
with the library definitions, so that a module generated by
`scripts/grand_challenges/gen_slot_arithmetic.py` can check the inequality block by block with
`decide +kernel` and state it in library terms.

## Main results

* `SlotArithmetic.firstOrderCurveShiftedHeightSlotCount_eq` and
  `SlotArithmetic.firstOrderCurveShiftedRowSlotBound_eq`: the library counts equal their
  kernel-reducible restatements.
* `SlotArithmetic.sumRange_add`: splitting a range sum into blocks.
-/

@[expose] public section

open ReedSolomon.HiddenDerivative

namespace ProximityGap.GrandChallenges.SlotArithmetic

/-- `sumRange N f = f 0 + ⋯ + f (N - 1)`, by structural recursion so that the kernel can reduce
it. -/
def sumRange : Nat → (Nat → Nat) → Nat
  | 0, _ => 0
  | N + 1, f => sumRange N f + f N

/-- Kernel-reducible restatement of `firstOrderCurveShiftedHeightSlotCount`. -/
def heightSlotCount (D A m M μ ℓ h : Nat) : Nat :=
  sumRange (μ + 1) fun t ↦
    sumRange (min t M + 1) fun b ↦ (m * A + b - D * t) * (h + 1 - ℓ * t)

/-- Kernel-reducible restatement of `firstOrderGradedSourceCount`. -/
def gradedSourceCount (D A m M s t : Nat) : Nat :=
  if s + (D - 1) * t < m * A then min t s + 1 - (t - M) else 0

/-- Kernel-reducible restatement of `firstOrderGradedRankBound`. -/
def gradedRankBound (D A m M t : Nat) : Nat :=
  sumRange m fun s ↦ min (m - s) (gradedSourceCount D A m M s t)

/-- Kernel-reducible restatement of `firstOrderCurveShiftedRowSlotBound`. -/
def rowSlotBound (D A m M μ n ℓ h : Nat) : Nat :=
  sumRange (μ + 1) fun t ↦ n * gradedRankBound D A m M t * (h + 1 - ℓ * t)

/-- `sumRange` is the `Finset.range` sum. -/
theorem sumRange_eq (N : ℕ) (f : ℕ → ℕ) : sumRange N f = ∑ i ∈ Finset.range N, f i := by
  induction N with
  | zero => rfl
  | succ N ih => rw [Finset.sum_range_succ, ← ih]; rfl

/-- Splitting a range sum into an initial segment and a shifted tail. -/
theorem sumRange_add (a b : Nat) (f : Nat → Nat) :
    sumRange (a + b) f = sumRange a f + sumRange b (fun i ↦ f (a + i)) := by
  induction b with
  | zero => rfl
  | succ b ih =>
    change sumRange (a + b) f + f (a + b) =
      sumRange a f + (sumRange b (fun i ↦ f (a + i)) + f (a + b))
    rw [ih, Nat.add_assoc]

/-- `firstOrderCurveShiftedHeightSlotCount` equals its kernel-reducible restatement. -/
theorem firstOrderCurveShiftedHeightSlotCount_eq (D A m M μ ℓ h : ℕ) :
    firstOrderCurveShiftedHeightSlotCount D A m M μ ℓ h = heightSlotCount D A m M μ ℓ h := by
  simp only [firstOrderCurveShiftedHeightSlotCount, heightSlotCount, sumRange_eq]

/-- `firstOrderCurveShiftedRowSlotBound` equals its kernel-reducible restatement. -/
theorem firstOrderCurveShiftedRowSlotBound_eq (D A m M μ n ℓ h : ℕ) :
    firstOrderCurveShiftedRowSlotBound D A m M μ n ℓ h = rowSlotBound D A m M μ n ℓ h := by
  simp only [firstOrderCurveShiftedRowSlotBound, rowSlotBound, firstOrderGradedRankBound,
    gradedRankBound, firstOrderGradedSourceCount, gradedSourceCount, sumRange_eq]

end ProximityGap.GrandChallenges.SlotArithmetic
