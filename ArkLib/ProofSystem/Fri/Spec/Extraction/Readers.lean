module

public import ArkLib.ProofSystem.Fri.Spec.Extraction.Generator
public import ArkLib.ProofSystem.Fri.Spec.QuerySoundness

/-!
# Certified retained-history reads

These instructions read arbitrary committed words, folding challenges, final polynomials, and
stored degree metadata. Selected initial-word reads reuse a point generated by the same program.
-/

@[expose] public section

namespace Fri.Spec.Extractor
open Domain OracleComp OracleSpec CompPoly
variable {F : Type} [NonBinaryField F] [Fintype F] [DecidableEq F]
variable {n k : ℕ} {ω : SmoothCosetFftDomain n F}
variable (s : Fin (k + 1) → ℕ+) (o : ∀ j, FinalOracleStatement s ω j)
variable (α : FinalStatement F k)

/-- Read one committed-word value at its actual domain point. -/
def readWord (i : Fin (k + 1))
    (x : (ω.subdomain (foldingPrefix s i.castSucc)).toFinset) :
    OracleComp (InstructionSpec s o α) {y : F // y = committedWord s o i x} :=
  liftM (OracleSpec.query (spec := InstructionSpec s o α) (.inr (.wordRead i x)))

/-- Read one immutable folding challenge. -/
def readChallenge (i : Fin (k + 1)) :
    OracleComp (InstructionSpec s o α) {a : F // a = α i} :=
  liftM (OracleSpec.query (spec := InstructionSpec s o α) (.inr (.challengeRead i)))

/-- Read the final polynomial without traversing its coefficients. -/
def readFinalPolynomial :
    OracleComp (InstructionSpec s o α) {p : CPolynomial F // p = finalPolynomial s o} :=
  liftM (OracleSpec.query (spec := InstructionSpec s o α) (.inr .finalPolynomialRead))

/-- Read the stored degree metadata of a computational polynomial. -/
def readDegree (p : CPolynomial F) :
    OracleComp (InstructionSpec s o α) {m : ℕ // m = p.natDegree} :=
  liftM (OracleSpec.query (spec := InstructionSpec s o α) (.inr (.polynomialDegreeRead p)))

/-- Generate the verifier's initial query as a subtype without another domain read. -/
def generateInitialQuery (gen : Generator ω) (z : Fin (2 ^ n)) :
    OracleComp (InstructionSpec s o α)
      {x : (ω.subdomain 0).toFinset // x = initialQuery z} := do
  let a ← initialPoint s o α gen z
  pure ⟨⟨a.val, by rw [a.property]; exact (initialQuery (ω := ω) z).property⟩,
    Subtype.ext a.property⟩

/-- Read a selected initial-word value at its already generated point. -/
def readSample (z : Fin (2 ^ n))
    (x : {q : (ω.subdomain 0).toFinset // q = initialQuery z}) :
    OracleComp (InstructionSpec s o α) {y : F // y = initialWord s o z} := do
  let q : (ω.subdomain (foldingPrefix s (0 : Fin (k + 1)).castSucc)).toFinset :=
    ⟨x.val.val, by
      have hprefix : foldingPrefix s (0 : Fin (k + 1)).castSucc = 0 := by
        simp [foldingPrefix]
      rw [hprefix]
      exact x.val.property⟩
  let y ← readWord s o α 0 q
  pure ⟨y.val, by
    rw [y.property]
    change committedWord s o (0 : Fin (k + 1)) q = committedFunction s o 0 (ω z)
    rw [← committedFunction_castSucc]
    have hq : q.val = ω z := congrArg Subtype.val x.property
    rw [hq]
    rfl⟩

end Fri.Spec.Extractor
