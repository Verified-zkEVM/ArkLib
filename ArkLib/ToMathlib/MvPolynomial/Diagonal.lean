module

public import Mathlib.Algebra.MvPolynomial.Funext
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.Tactic.Ring

/-!
# Substituting one variable for another, and points off the diagonals

The substitution `X d ↦ X j` is `MvPolynomial.rename (Function.update id d j)`. Its kernel is
contained in the ideal generated by `X d - X j`. Over an infinite domain, a nonzero polynomial in
finitely many variables does not vanish at some point whose coordinates are pairwise distinct.

## Main statements

* `MvPolynomial.X_sub_X_dvd_sub_rename_update`: `X d - X j` divides `p - p[X d := X j]`.
* `MvPolynomial.X_sub_X_dvd_of_rename_update_eq_zero`: the kernel of the substitution.
* `MvPolynomial.not_isUnit_X_sub_X`: `X d - X j` is not a unit.
* `MvPolynomial.exists_injective_eval_ne_zero`: a non-root with pairwise distinct coordinates.
-/

@[expose] public section

namespace MvPolynomial

variable {R σ : Type*} [CommRing R]

/-- `X d - X j` divides the difference between `p` and its image under the substitution
`X d ↦ X j`. -/
theorem X_sub_X_dvd_sub_rename_update [DecidableEq σ] (d j : σ) (p : MvPolynomial σ R) :
    X d - X j ∣ p - rename (Function.update id d j) p := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    rw [map_add, add_sub_add_comm]
    exact dvd_add hp hq
  | mul_X p n hp =>
    have hn : (X n : MvPolynomial σ R) - rename (Function.update id d j) (X n) =
        if n = d then X d - X j else 0 := by
      rw [rename_X]
      by_cases h : n = d
      · subst h
        simp
      · simp [h]
    have hsplit : p * X n - rename (Function.update id d j) (p * X n) =
        (p - rename (Function.update id d j) p) * X n +
          rename (Function.update id d j) p * (X n - rename (Function.update id d j) (X n)) := by
      rw [map_mul]
      ring
    rw [hsplit, hn]
    refine dvd_add (dvd_mul_of_dvd_left hp _) (dvd_mul_of_dvd_right ?_ _)
    split_ifs <;> simp

/-- The kernel of the substitution `X d ↦ X j` is contained in the ideal generated by
`X d - X j`. -/
theorem X_sub_X_dvd_of_rename_update_eq_zero [DecidableEq σ] {d j : σ}
    {p : MvPolynomial σ R} (h : rename (Function.update id d j) p = 0) : X d - X j ∣ p := by
  simpa [h] using X_sub_X_dvd_sub_rename_update (R := R) d j p

/-- `X d - X j` is not a unit. -/
theorem not_isUnit_X_sub_X [IsDomain R] (d j : σ) :
    ¬ IsUnit (X d - X j : MvPolynomial σ R) := by
  intro h
  have := h.map (MvPolynomial.eval (0 : σ → R))
  simp at this

/-- A nonzero polynomial over an infinite domain does not vanish at some point with pairwise
distinct coordinates. -/
theorem exists_injective_eval_ne_zero [IsDomain R] [Infinite R] [Finite σ]
    {p : MvPolynomial σ R} (hp : p ≠ 0) :
    ∃ x : σ → R, Function.Injective x ∧ eval x p ≠ 0 := by
  classical
  have := Fintype.ofFinite σ
  let D : MvPolynomial σ R :=
    ∏ ij ∈ (Finset.univ : Finset (σ × σ)).filter (fun ij => ij.1 ≠ ij.2), (X ij.1 - X ij.2)
  have hD : D ≠ 0 := Finset.prod_ne_zero_iff.2 fun ij hij =>
    sub_ne_zero.2 fun h => (Finset.mem_filter.1 hij).2 (X_injective h)
  obtain ⟨x, hx⟩ : ∃ x, eval x (p * D) ≠ 0 := by
    by_contra h
    push Not at h
    exact mul_ne_zero hp hD (MvPolynomial.funext fun x => by simp [h x])
  refine ⟨x, fun a b hab => ?_, fun h => hx (by simp [h])⟩
  by_contra hne
  apply hx
  rw [map_mul]
  refine mul_eq_zero_of_right _ ?_
  rw [map_prod]
  exact Finset.prod_eq_zero (Finset.mem_filter.2 ⟨Finset.mem_univ (a, b), hne⟩) (by simp [hab])

end MvPolynomial
