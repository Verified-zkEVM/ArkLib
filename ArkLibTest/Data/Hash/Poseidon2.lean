import ArkLib.Data.Hash.Poseidon2

/-!
# Acceptance tests for Poseidon2 over KoalaBear

Known answers of Plonky3's `default_koalabear_poseidon2_16` and `_24`, whose constants are
leanSpec's, on the zero state, the state `0, 1, …, width - 1` and Plonky3's random test vector.
-/

namespace Poseidon2

def permuteNat (params : Params) (x : Vector Nat params.width) : List Nat :=
  (permute params (x.map Nat.cast)).toList.map ZMod.val

example : permuteNat params16 (Vector.replicate 16 0) = [1194359470, 20586639, 1240637140,
  1730441233, 2130651597, 2003319866, 1017798662, 222976322, 488727120, 474647328, 1184838029,
  219759704, 2028817067, 2056706922, 1578739509, 2000630822] := by
  decide +kernel

